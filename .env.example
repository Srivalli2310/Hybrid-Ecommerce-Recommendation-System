# MongoDB Atlas Connection String (replace with your MongoDB cluster connection)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.keverxa.mongodb.net/?appName=Cluster0

# MongoDB Database Name
DATABASE_NAME=hybrid_ecommerce

# Flask Session Security Key (generate a random 32-character secret)
SECRET_KEY=hybrid-ecommerce-production-secret-key-change-me

# Server Port (optional, defaults to 5000)
PORT=5000

# Flask Debug Mode (True for local development, False for production)
FLASK_DEBUG=False
